# Copy this file to .env and adjust as needed. All values are optional —
# the application runs with safe defaults if no .env file is present.

# Seconds to wait for a WiFi scan before giving up.
SCAN_TIMEOUT=20

# Seconds to wait for connected-device (ARP) discovery before giving up.
DEVICE_SCAN_TIMEOUT=15

# Enable periodic automatic re-scanning from the dashboard.
AUTO_REFRESH=false
AUTO_REFRESH_INTERVAL=60

# Automatically persist every completed WiFi scan to Scan History.
AUTO_SAVE_HISTORY=true

# Python logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
